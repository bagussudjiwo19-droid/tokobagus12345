{
  "expo": {
    "name": "Toko Bagus",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.appauditpreview.b4uyup",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcode produk saat berjualan",
        "NSBluetoothAlwaysUsageDescription": "Hubungkan printer struk Bluetooth",
        "NSBluetoothPeripheralUsageDescription": "Cetak struk ke printer Bluetooth",
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.appauditpreview.b4uyup",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcode produk saat berjualan",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Cetak struk ke printer Bluetooth",
          "alwaysUsageDescription": "Hubungkan printer struk Bluetooth"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
